# Required: Discord Developer Portal > your application > Bot
DISCORD_TOKEN=

# Configure at least one AI provider. Gemini is tried first when set.
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Enable Message Content Intent in the Discord Developer Portal too.
MESSAGE_CONTENT_INTENT=1

# Games, virtual economy, and social commands: 0 = paused, 1 = enabled.
SWITZER_GAMES_ENABLED=0

# Image provider: pollinations or openrouter.
IMAGE_PROVIDER=pollinations
POLLINATIONS_IMAGE_MODEL=flux
IMAGE_MODEL=google/gemini-3.1-flash-lite-image
